# Copie para .env.local e preencha. Valores do painel do Supabase: Project Settings > API.
# A publishable key pode ficar no navegador; quem protege os dados e o RLS do banco.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Domínio de produção, sem barra no fim. Usado no canonical, nas tags Open Graph, no robots.txt e no sitemap.xml.
# Sem ele, vale o padrão de src/lib/site.ts.
VITE_SITE_URL=https://crai.ia.br
